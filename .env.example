# CerviGrade demo/local development template.
# Copy to .env and replace placeholder values. Do not commit .env.

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate unique values per environment.
AUTH_SECRET=replace-with-local-demo-secret
NEXTAUTH_SECRET=replace-with-local-demo-secret

# Local development database. prisma/dev.db is ignored and must not be committed.
DATABASE_URL=file:./prisma/dev.db

# Required for buyer-demo flow.
ENABLE_BATCH_DEMO=true

# Core modules are enabled by default; keep these explicit for demo reproducibility.
ENABLE_LEGACY_CERVICAL=true
ENABLE_CASES_V2=true
ENABLE_DOCUMENT_INGEST=true
ENABLE_COLPOSCOPY_MODULE=true
ENABLE_GYNAECOLOGY_MODULE=true

# Stub integrations remain off unless a separate integration workstream is approved.
ENABLE_AI_ASSIST=false
ENABLE_RESTRICTED_COLPO_INTEGRATION=false

# Remote libSQL/Turso deployments only. Leave empty for local file DB.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_AUTH_TOKEN=
