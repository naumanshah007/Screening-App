digraph CerviGradeMasterV21 {
graph [rankdir=TB, compound=false, newrank=true, pack=true, packmode="array_u2", splines=polyline, nodesep=0.28, ranksep=0.42, pad=0.25, bgcolor="#FFFFFF", fontname="Arial", fontsize=18, labelloc=t, label="CerviGrade NCSP Master Decision Tree v2.1\nJune 2023 pathways + Feb/Mar 2026 controlling updates\nProvisional recommendation - reviewer confirmation required - not for direct clinical action"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.12,0.08", color="#164E63", fillcolor="#E6F7FA", penwidth=1.3];
edge [fontname="Arial", fontsize=8.5, color="#475569", arrowsize=0.7, penwidth=1.1];
subgraph cluster_legend { label="Legend"; color="#CBD5E1"; style="rounded"; penwidth=1.6;
L_IN [label="Input / process", fillcolor="#E6F7FA", color="#0F6B7A"];
L_DEC [label="Decision", shape="diamond", fillcolor="#F1F5F9", color="#64748B"];
L_SAFE [label="Safety stop / missing information", shape="octagon", fillcolor="#DBEAFE", color="#1D4ED8"];
L_CLIN [label="Clinician / MDM / specialist decision", fillcolor="#FFF4CC", color="#B7791F"];
L_URG [label="Urgent / oncology escalation", shape="doubleoctagon", fillcolor="#FEE2E2", color="#B91C1C"];
L_END [label="Completed routine endpoint", shape="doublecircle", fillcolor="#EDE9FE", color="#6D28D9"];
L_UPD [label="2026 controlling update", fillcolor="#DCFCE7", color="#15803D"];
{rank=same; L_IN; L_DEC; L_SAFE; L_CLIN; L_URG; L_END; L_UPD;}
}
subgraph cluster_router { label="GLOBAL ROUTER AND SAFETY GATES"; color="#1E3A8A"; style="rounded"; penwidth=1.6;
START [label="Case intake\nSynthetic/de-identified data only", shape="oval", fillcolor="#DBEAFE", color="#1D4ED8", fontsize=12];
MIN [label="Minimum routing facts complete?", shape="diamond", fillcolor="#F8FAFC", color="#475569"];
STOP [label="INSUFFICIENT_INFORMATION / EXTERNAL_HISTORY_REQUIRED\nUnknown is not false or normal", shape="octagon", fillcolor="#DBEAFE", color="#1D4ED8"];
SYM [label="Abnormal bleeding or cancer concern?", shape="diamond"];
PREG [label="Pregnant?", shape="diamond"];
HYSTQ [label="Hysterectomy / cervix status relevant?", shape="diamond"];
CANCQ [label="Previous cervical/vaginal/gynaecological cancer?", shape="diamond"];
DESQ [label="Known in-utero DES exposure?", shape="diamond"];
UNRES [label="Unresolved prior high-grade or glandular history?", shape="diamond"];
TOCQ [label="Active or required high-grade squamous Test of Cure?", shape="diamond"];
GLQ [label="Current glandular abnormality / AIS / adenocarcinoma?", shape="diamond"];
F4Q [label="Normal colposcopy after low-grade cytology?", shape="diamond"];
F5Q [label="Normal colposcopy after cytology >= ASC-H?", shape="diamond"];
TRANSQ [label="First transition from cytology programme?", shape="diamond"];
U25Q [label="Asymptomatic and age <25?", shape="diamond"];
U25STOP [label="Routine screening not recommended\nSymptoms/follow-up override; clinician review for early sexual activity/abuse", shape="octagon", fillcolor="#DBEAFE", color="#1D4ED8"];
PRIMARYQ [label="Asymptomatic primary HPV screening", fillcolor="#DFF7F4", color="#0F766E"];
PWC [label="After selecting a pathway:\nvalidate that pathway's mandatory facts\nbefore any terminal recommendation", shape="note", fillcolor="#F8FAFC", color="#64748B"];
START -> MIN;
MIN -> STOP [label="No"];
MIN -> SYM [label="Yes"];
SYM -> PREG [label="No"];
PREG -> HYSTQ [label="No"];
HYSTQ -> CANCQ [label="No"];
CANCQ -> DESQ [label="No"];
DESQ -> UNRES [label="No"];
UNRES -> TOCQ [label="No"];
TOCQ -> GLQ [label="No"];
GLQ -> F4Q [label="No"];
F4Q -> F5Q [label="No"];
F5Q -> TRANSQ [label="No"];
TRANSQ -> U25Q [label="No"];
U25Q -> U25STOP [label="Yes"];
U25Q -> PRIMARYQ [label="No"];
START -> PWC [style="dotted", constraint="false"];
}
subgraph cluster_f1 { label="FIGURE 1 - Transition: resolved/no previous abnormal history"; color="#7C3AED"; style="rounded"; penwidth=1.6;
F1_ENTRY [label="Transition participant"];
F1_COMP [label="Figure 1 mandatory facts complete?", shape="diamond"];
F1_CSTOP [label="Missing transition/history facts -> request information", shape="octagon", fillcolor="#DBEAFE", color="#1D4ED8"];
F1_HIST [label="Screening/history state?", shape="diamond"];
F1_NOW [label="Never screened / under-screened / overdue\nInvite now"];
F1_NEXT [label="Regular/normal, previous low-grade returned,\nor previous high-grade with completed ToC\nInvite at next scheduled visit"];
F1_F3 [label="HPV primary screening at next visit\n-> Figure 3", fillcolor="#EDE9FE", color="#6D28D9"];
F1_UNRES [label="Unresolved high-grade/glandular history\nDo not use Figure 1 -> Figure 2", shape="octagon", fillcolor="#DBEAFE", color="#1D4ED8"];
F1_ENTRY -> F1_COMP;
F1_COMP -> F1_CSTOP [label="No"];
F1_COMP -> F1_HIST [label="Yes"];
F1_HIST -> F1_NOW [label="Never/under/overdue"];
F1_HIST -> F1_NEXT [label="Resolved/regular"];
F1_HIST -> F1_UNRES [label="Unresolved"];
F1_NOW -> F1_F3;
F1_NEXT -> F1_F3;
}
