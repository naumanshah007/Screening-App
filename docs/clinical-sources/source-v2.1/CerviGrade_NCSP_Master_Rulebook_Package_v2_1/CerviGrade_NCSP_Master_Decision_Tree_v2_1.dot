F2_COLQ -> F2_COL [label="Yes"];
F2_COLQ -> F2_FU [label="No"];
F2_COL -> F2_FU [label="After colposcopy plan"];
F2_FU -> F2_DONE [label="Completed"];
F2_AIS -> F2_AISFU;
F2_ENDO -> F2_ENDOQ;
