{
  "name": "cervical-screening-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/engine/__tests__/*.test.ts\"",
    "test:engine": "tsx --test \"lib/engine/__tests__/*.test.ts\"",
    "test:batch": "tsx --test \"lib/batch/__tests__/*.test.ts\"",
    "test:rules": "tsx --test \"lib/clinical-rules/__tests__/*.test.ts\"",
    "test:router": "tsx --test \"lib/engine/__tests__/source-router-regression.test.ts\"",
    "test:security": "tsx --test \"tests/security/*.test.ts\"",
    "test:conformance": "tsx --test \"tests/clinical-conformance/*.test.ts\"",
    "test:all": "npm run test:engine && npm run test:batch && npm run test:rules && npm run test:router && npm run test:security && npm run test:conformance && npm run test:db && npm run test:integrations && npm run test:ui",
    "// test:source-verification": "Requires the external v2.1 source package. See docs/canonical-cutover/13-source-artifact-and-reproducibility.md",
    "test:source-verification": "tsx --test \"lib/clinical-rules/__tests__/governed-snapshot-source-verification.test.ts\" \"lib/clinical-rules/__tests__/successor-v3-1.test.ts\"",
    "rules:export:snapshot": "tsx scripts/rule-studio/export-governed-snapshot.ts",
    "rules:import:v2.1": "tsx scripts/import-ncsp-rulebook-v2-1.ts",
    "rules:import:v2.1:successor": "tsx scripts/import-ncsp-rulebook-v2-1-successor.ts",
    "rules:simulate:v2-input-gaps": "tsx scripts/rule-studio/persist-canonical-v2-input-gap-simulations.ts",
    "typecheck": "tsc --noEmit",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:db": "tsx scripts/run-db-tests.ts",
    "test:integrations": "tsx --test \"tests/integrations/*.test.ts\"",
    "usage:remediate-orphans": "tsx scripts/remediate-usage-orphans.ts",
    "pilot:recovery:rehearse": "tsx scripts/pilot/rehearse-local-restore.ts",
    "pilot:migrations:verify": "tsx scripts/pilot/verify-migration-chain.ts",
    "rules:report:timing": "tsx scripts/rule-studio/timing-classification-report.ts",
    "test:ui": "tsx --test \"tests/ui/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
