// Source-agnostic ingest provenance for a batch run. The adapter layer
// (lib/batch/adapters) already anticipates HL7v2 lab feeds, FHIR, and
// eReferral/ERMS — these map onto the same review workflow.
enum BatchRunSource {
  DEMO
  CSV
  XLSX
  JSON
  MANUAL
  HL7
  FHIR
  ERMS
  HEALTH_NZ
}

enum BatchReviewDisposition {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

enum ClinicalRuleScope {
  GLOBAL
  ORGANISATION
}

enum ClinicalRuleVersionStatus {
  DRAFT
  VALIDATING
  VALIDATED
  PUBLISHED
  ACTIVE
  RETIRED
  ARCHIVED
}

enum ClinicalRuleChangeClassification {
  DISPLAY_ONLY
  OPERATIONAL
  CLINICAL_LOGIC
}

enum RuleActivationEnvironment {
  DEMO
  TEST
  VALIDATION
  PRODUCTION
}

enum RuleEvaluationMode {
  LIVE_DEMO
  SHADOW
  SIMULATION
  // Clinically operative evaluation in the production environment. Reachable
  // only when an ACTIVE PRODUCTION RuleSetActivation exists AND
  // CLINICAL_AUTHORITY_LIVE_PRODUCTION is enabled. Recorded distinctly from
  // LIVE_DEMO so the immutable evaluation record never overstates or
  // understates the clinical status of a real participant decision.
  //
  // NO MIGRATION IS REQUIRED. This datasource is SQLite, where Prisma stores
  // enums as TEXT with no database-level constraint, so adding a member changes
  // no table and rewrites no row. (An earlier draft of this change carried a
  // Postgres `ALTER TYPE ... ADD VALUE` migration; that was wrong for this
  // datasource and would have failed. It was removed.)
  LIVE_PRODUCTION
}

// ─── Auth / User Models ───────────────────────────────────────────────────────

model User {
  id                            String                  @id @default(cuid())
  name                          String?
  email                         String                  @unique
  emailVerified                 DateTime?
  image                         String?
  passwordHash                  String?
  passwordChangeRequired        Boolean                 @default(false)
  passwordChangedAt             DateTime?
  passwordExpiresAt             DateTime?
  role                          UserRole                @default(GP)
  twoFASecret                   String?
  twoFAEnabled                  Boolean                 @default(false)
  twoFARecoveryCodesJson        String?
  failedAttempts                Int                     @default(0)
  lockedUntil                   DateTime?
  lastLoginAt                   DateTime?
  /// Administrative enable/disable. A disabled account cannot authenticate at
  /// all — checked in the credentials provider before any password comparison,
  /// so disabling is immediate and does not wait for session expiry.
  isActive                      Boolean                 @default(true)
  /// True for the seeded demonstration identities. Lets handover readiness
  /// enumerate exactly which accounts must be removed or converted, and keeps
  /// the demo reset control from ever targeting a real account.
  isDemoAccount                 Boolean                 @default(false)
  gpPracticeId                  String?
  gpPractice                    GPPractice?             @relation(fields: [gpPracticeId], references: [id])
  accounts                      Account[]
  sessions                      Session[]
  auditLogs                     AuditLog[]
  createdCases                  ReferralCase[]          @relation("CaseCreator")
  assignedCases                 ReferralCase[]          @relation("CaseAssignee")
  clinicianDecisions            ClinicianDecision[]     @relation("CaseDecisionMaker")
  uploadedDocuments             ReferralDocument[]      @relation("DocumentUploader")
  approvedSummaries             ClinicalSummary[]       @relation("CaseSummaryApprover")
  reviewedCaseRules             CaseRuleSetRelease[]    @relation("CaseRuleReviewer")
  publishedCaseRules            CaseRuleSetRelease[]    @relation("CaseRulePublisher")
  createdSessions               ScreeningSession[]
  createdClinicalRuleVersions   ClinicalRuleVersion[]   @relation("ClinicalRuleVersionCreator")
  approvedClinicalRuleVersions  ClinicalRuleVersion[]   @relation("ClinicalRuleVersionApprover")
  publishedClinicalRuleVersions ClinicalRuleVersion[]   @relation("ClinicalRuleVersionPublisher")
  clinicalRuleActivations       RuleSetActivation[]     @relation("ClinicalRuleActivationActor")
  clinicalRuleAuditEvents       RuleVersionAuditEvent[] @relation("ClinicalRuleAuditActor")
  pathwayHistory                PathwayStateHistory[]
  colposcopyFindings            ColposcopyFinding[]
  wizardSessions                WizardSession[]
  accessCertifications          AccessCertification[]
  integrationValidations        IntegrationValidation[] @relation("IntegrationValidationReviewer")
  openedSecurityIncidents       SecurityIncident[]      @relation("SecurityIncidentOpenedBy")
  assignedSecurityIncidents     SecurityIncident[]      @relation("SecurityIncidentAssignedTo")
  batchRuns                     BatchRun[]              @relation("BatchRunCreator")
  reviewedBatchItems            BatchReviewItem[]       @relation("BatchItemReviewer")
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
}

model AccessCertification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemName        String
  certificationType String
  completedAt       DateTime
  expiresAt         DateTime?
  active            Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, systemName, active])
  @@index([systemName, active, expiresAt])
}

model IntegrationValidation {
  id                String                       @id @default(cuid())
  integrationId     String
  environment       String                       @default("current")
  outcome           IntegrationValidationOutcome
  summary           String
  notes             String?
  validatedAt       DateTime
  expiresAt         DateTime?
  validatedByUserId String
  validatedBy       User                         @relation("IntegrationValidationReviewer", fields: [validatedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([integrationId, validatedAt])
  @@index([validatedByUserId, validatedAt])
}

model SecurityIncident {
  id               String                   @id @default(cuid())
  title            String
  summary          String
  severity         SecurityIncidentSeverity
  status           SecurityIncidentStatus   @default(OPEN)
  dueAt            DateTime?
  lastReminderAt   DateTime?
  sourcePreset     String?
  sourceEntity     String?
  sourceAction     String?
  sourceUserId     String?
  auditFilterJson  String?
  openedByUserId   String
  openedBy         User                     @relation("SecurityIncidentOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignedTo       User?                    @relation("SecurityIncidentAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, severity, createdAt])
  @@index([assignedToUserId, status])
  @@index([sourcePreset, status])
  @@index([status, dueAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Practice Model ────────────────────────────────────────────────────────────

model GPPractice {
  id        String    @id @default(cuid())
  name      String
  address   String?
  dhbRegion String?
  hpiNumber String?   @unique
  users     User[]
  patients  Patient[]
  recalls   Recall[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Tenancy ───────────────────────────────────────────────────────────────────

/// The customer whose service is being operated and, later, billed.
///
/// NOT the same thing as where data came from. A lab sends results to a service;
/// they are different parties. The originating facility stays on the case as
/// source metadata. This model is the tenant only.
///
/// NOT the same thing as GPPractice either, which is a referrer.
///
/// `key` intentionally holds the same values as `RuleSetActivation.organisationKey`,
/// which already scopes which governed ruleset is active for an organisation. That
/// column stays a plain string so the existing precedence logic in
/// lib/clinical-rules/current-ruleset.ts is untouched by this model.
///
/// Deployments are single-tenant for now: exactly one row, resolved by
/// lib/organisation/current-organisation.ts. Nothing here implements tenant
/// switching, and no request carries an organisation — that is deliberate.
model Organisation {
  id        String     @id @default(cuid())
  /// Stable lookup key, e.g. "counties-manukau". Matches RuleSetActivation.organisationKey.
  key       String     @unique
  name      String
  shortName String?
  isActive  Boolean    @default(true)
  batchRuns BatchRun[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive])
}

// ─── Patient Model ─────────────────────────────────────────────────────────────

model Patient {
  id           String        @id @default(cuid())
  nhi          String        @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  email        String?
  phone        String?
  address      String?
  gpPracticeId String?
  gpPractice   GPPractice?   @relation(fields: [gpPracticeId], references: [id])
  status       PatientStatus @default(ACTIVE)

  // Phase 1 critical fix: Module A routing detection
  isFirstTimeHPVTransition Boolean        @default(false)
  previousScreeningType    ScreeningType?
  lastCytologyDate         DateTime?

  // Flags
  isPostHysterectomy Boolean   @default(false)
  hysterectomyDate   DateTime?
  hysterectomyType   String? // TOTAL, SUBTOTAL

  // NZ ethnicity (Level 2 codes: "21" Māori, "30" Pacific, "10" NZ European, etc.)
  ethnicityPrimary    String?
  ethnicityOther      String? // Secondary ethnicity code
  interpreterRequired Boolean @default(false)
  preferredLanguage   String? // ISO 639-1 code, e.g. "mi" for te reo Māori

  // NHI validation tracking
  nhiValidatedAt DateTime?

  // Soft delete
  deletedAt       DateTime?
  deletedByUserId String?

  screeningSessions ScreeningSession[]
  referralCases     ReferralCase[]
  medicalHistory    MedicalHistory?
  recalls           Recall[]
  wizardSessions    WizardSession[]
  consentRecords    PatientConsent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([nhi])
  @@index([status])
  @@index([deletedAt])
  @@index([ethnicityPrimary])
}

// ─── Enterprise Referral Case Foundation ─────────────────────────────────────

model ReferralCase {
  id                  String             @id @default(cuid())
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id])
  serviceLine         ServiceLine
  status              CaseStatus         @default(NEW)
  receivedAt          DateTime           @default(now())
  referralSource      String?
  externalCaseId      String?
  referralReason      String?
  currentPriority     TriagePriority?
  currentCategory     String?
  targetDueAt         DateTime?
  bookedForAt         DateTime?
  bookedAt            DateTime?
  bookingNotes        String?
  assignedToUserId    String?
  assignedTo          User?              @relation("CaseAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId     String
  createdBy           User               @relation("CaseCreator", fields: [createdByUserId], references: [id])
  documents           ReferralDocument[]
  extractedFacts      ExtractedFact[]
  summary             ClinicalSummary?
  ruleDecision        RuleDecision?
  authorityPin        CaseAuthorityPin?
  clinicianDecision   ClinicianDecision?
  highSuspicionCancer Boolean            @default(false)
  smoOnly             Boolean            @default(false)
  regradeOfCaseId     String?
  triageNotes         String?

  // ─── Colposcopy-specific triage fields ─────────────────────────────────────
  fctStatus            String? // Confirmed cancer / High suspicion / No/Low suspicion
  hpvTestResult        String? // HPV test result value
  hpvType              String? // HPV 16, HPV 18, Not applicable, Oncogenic, Other
  cytologySample       String? // Cytology sample result
  referrerReasonCode   String? // Structured referrer reason code
  assessmentOfReferral String? // Clinical assessment of referral
  bookingPriorityNote  String? // Booking priority notes/override
  referralType         String? // Type of referral
  ovestinInstruction   String? // Ovestin cream instruction
  ncsrNoteAdded        Boolean? // NCSR Note added flag
  referralNoteAdded    Boolean? // Referral Note added flag
  internalTriageNotes  String? // Internal triage notes (separate from triageNotes)

  // ─── Gynaecology-specific triage fields ────────────────────────────────────
  gynaecologyCategory String? // AUB, Fibroids, Ovarian Mass, PMB, Pelvic Pain, etc.
  ussAvailable        Boolean? // Ultrasound scan available
  ussFindings         String? // USS findings summary

  // ─── Relations ─────────────────────────────────────────────────────────────
  investigations    CaseInvestigation[]
  aiRecommendations AIRecommendation[]

  // Soft delete
  deletedAt       DateTime?
  deletedByUserId String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ruleEvaluations RuleEvaluation[]

  @@index([serviceLine, status, receivedAt])
  @@index([patientId, serviceLine, createdAt])
  @@index([assignedToUserId, status])
  @@index([currentPriority, status, receivedAt])
  @@index([targetDueAt, status])
  @@index([bookedForAt, status])
  @@index([deletedAt])
}

model ReferralDocument {
  id               String                   @id @default(cuid())
  caseId           String
  referralCase     ReferralCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type             DocumentType             @default(OTHER)
  fileName         String
  storageKey       String                   @unique
  mimeType         String
  byteSize         Int
  uploadedByUserId String?
  uploadedBy       User?                    @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  ocrStatus        DocumentProcessingStatus @default(PENDING)
  parseStatus      DocumentProcessingStatus @default(PENDING)
  pageCount        Int?
  pages            DocumentPage[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([caseId, type, createdAt])
  @@index([uploadedByUserId, createdAt])
}

model ClinicalSummary {
  id               String        @id @default(cuid())
  caseId           String        @unique
  referralCase     ReferralCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status           SummaryStatus @default(DRAFT)
  summaryJson      String
  renderedMarkdown String
  generatedBy      String
  approvedByUserId String?
  approvedBy       User?         @relation("CaseSummaryApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, updatedAt])
  @@index([approvedByUserId, approvedAt])
}

model CaseRuleSetRelease {
  id                String         @id @default(cuid())
  serviceLine       ServiceLine
  version           String
  name              String
  description       String?
  definitionJson    String
  schemaVersion     String         @default("1.0")
  isActive          Boolean        @default(false)
  publishedAt       DateTime?
  publishedByUserId String?
  publishedBy       User?          @relation("CaseRulePublisher", fields: [publishedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedBy        User?          @relation("CaseRuleReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  changeNotes       String?
  ruleDecisions     RuleDecision[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([serviceLine, version])
  @@index([serviceLine, isActive, publishedAt])
  @@index([reviewedByUserId, reviewedAt])
}

/// Immutable record of the clinical authority a case is bound to.
///
/// WHY THIS EXISTS
/// ---------------
/// Authority used to be derived at read time from the earliest operative
/// RuleEvaluation. A case decided under Legacy writes no RuleEvaluation, so it
/// produced no pin, and a global activation would silently re-evaluate it under
/// canonical. Policy requires a case to stay on the authority under which its
/// decision was actually made, so the pin is persisted rather than inferred.
///
/// One row per case, written once. `origin` records how the pin was established
/// so a backfilled pin is never mistaken for one written at decision time.
model CaseAuthorityPin {
  id                 String       @id @default(cuid())
  caseId             String       @unique
  referralCase       ReferralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorityEngine    String
  ruleVersionId      String?
  ruleVersionDisplay String?
  rulesetChecksum    String?
  engineVersion      String
  evaluationId       String?
  evaluationMode     String?
  /// When the pinned decision was made — not when this row was written.
  pinnedAt           DateTime
  /// FIRST_OPERATIVE_EVALUATION | LEGACY_DECISION_BACKFILL | LEGACY_DECISION
  origin             String
  createdAt          DateTime     @default(now())

  @@index([authorityEngine, pinnedAt])
}

model RuleDecision {
  id               String              @id @default(cuid())
  caseId           String              @unique
  referralCase     ReferralCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ruleSetReleaseId String?
  ruleSetRelease   CaseRuleSetRelease? @relation(fields: [ruleSetReleaseId], references: [id])
  priority         TriagePriority?
  category         String?
  outcome          String
  rationale        String
  evidenceJson     String
  traceJson        String
  generatedBy      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([priority, updatedAt])
  @@index([ruleSetReleaseId, updatedAt])
}

model ClinicianDecision {
  id              String          @id @default(cuid())
  caseId          String          @unique
  referralCase    ReferralCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decidedByUserId String
  decidedBy       User            @relation("CaseDecisionMaker", fields: [decidedByUserId], references: [id])
  finalPriority   TriagePriority?
  finalCategory   String?
  finalOutcome    String
  overrideReason  String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([finalPriority, updatedAt])
  @@index([decidedByUserId, updatedAt])
}

model DocumentPage {
  id            String           @id @default(cuid())
  documentId    String
  document      ReferralDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  extractedText String
  facts         ExtractedFact[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([documentId, pageNumber])
  @@index([documentId, createdAt])
}

model ExtractedFact {
  id             String       @id @default(cuid())
  caseId         String
  referralCase   ReferralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentPageId String
  documentPage   DocumentPage @relation(fields: [documentPageId], references: [id], onDelete: Cascade)
  factType       String
  label          String
  valueText      String
  valueDate      DateTime?
  valueNumber    Float?
  confidence     Float?
  sourceQuote    String?
  createdAt      DateTime     @default(now())

  @@index([caseId, factType])
  @@index([documentPageId])
}

// ─── Medical History ──────────────────────────────────────────────────────────

model MedicalHistory {
  id                         String    @id @default(cuid())
  patientId                  String    @unique
  patient                    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  previousHighGradeLesion    Boolean   @default(false)
  previousTreatment          String?
  treatmentDate              DateTime?
  immunocompromised          Boolean   @default(false)
  hiv                        Boolean   @default(false)
  // Phase 1 critical fix: AG2 routing
  atypicalEndometrialHistory Boolean   @default(false)
  otherRelevantHistory       String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

// ─── Screening Session ─────────────────────────────────────────────────────────

model ScreeningSession {
  id                  String         @id @default(cuid())
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id])
  createdById         String
  createdBy           User           @relation(fields: [createdById], references: [id])
  status              SessionStatus  @default(IN_PROGRESS)
  activeModule        PathwayFigure?
  activeModuleVersion String? // Track which rule version used

  // Phase 1 critical fix: Consecutive counter tracking (Test of Cure)
  consecutiveNegativeCoTestCount Int @default(0)
  consecutiveLowGradeCount       Int @default(0)

  // Phase 1 critical fix: Unsatisfactory cytology counter
  unsatisfactoryCytologyCount Int @default(0)

  // Risk classification
  currentRiskLevel   RiskLevel?
  nextScreeningDue   DateTime?
  recommendation     String?
  recommendationCode String?

  testResults        TestResult[]
  colposcopyFindings ColposcopyFinding[]
  referrals          Referral[]
  pathwayHistory     PathwayStateHistory[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([patientId, status, createdAt])
}

// ─── Test Result ──────────────────────────────────────────────────────────────

model TestResult {
  id                 String           @id @default(cuid())
  screeningSessionId String
  screeningSession   ScreeningSession @relation(fields: [screeningSessionId], references: [id])
  testDate           DateTime
  labId              String?
  specimenId         String?

  // Phase 1 critical fix: Sample type (Figure 3 branching)
  sampleType SampleType?

  // HPV result
  hpvResult HPVResult?
  hpv16_18  Boolean?
  hpvOther  Boolean?

  // Cytology result (structured vocabulary)
  cytologyResult   CytologyResult?
  cytologyAdequacy String?

  // Histology result
  histologyResult HistologyResult?

  // Phase 1 critical fix: TZ type for Figure 4/5/7 exceptions
  tzType TZType?

  pathwayHistory PathwayStateHistory[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// ─── Colposcopy Finding (New Model) ───────────────────────────────────────────

model ColposcopyFinding {
  id                 String           @id @default(cuid())
  screeningSessionId String
  screeningSession   ScreeningSession @relation(fields: [screeningSessionId], references: [id])
  clinicianId        String
  clinician          User             @relation(fields: [clinicianId], references: [id])
  colposcopyDate     DateTime

  // Phase 1 critical fix: TZ type stored
  tzType                TZType?
  visibleLesion         Boolean                @default(false)
  colposcopicImpression ColposcopicImpression?
  acetowhiteChange      Boolean                @default(false)
  iodineNegative        Boolean                @default(false)
  atypicalVessels       Boolean                @default(false)
  biopsyTaken           Boolean                @default(false)
  biopsyResult          HistologyResult?
  biopsySite            String?
  mdmReviewRequired     Boolean                @default(false)
  mdmOutcome            String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// ─── Pathway State History (New Model - State Machine) ────────────────────────

model PathwayStateHistory {
  id                  String           @id @default(cuid())
  screeningSessionId  String
  screeningSession    ScreeningSession @relation(fields: [screeningSessionId], references: [id])
  fromState           String?
  toState             String
  transitionReason    String?
  triggeredByResultId String?
  triggeredByResult   TestResult?      @relation(fields: [triggeredByResultId], references: [id])
  createdByUserId     String
  createdBy           User             @relation(fields: [createdByUserId], references: [id])
  pathwayFigure       PathwayFigure?
  riskLevel           RiskLevel?
  createdAt           DateTime         @default(now())
}

// ─── Referral ─────────────────────────────────────────────────────────────────

model Referral {
  id                 String           @id @default(cuid())
  screeningSessionId String
  screeningSession   ScreeningSession @relation(fields: [screeningSessionId], references: [id])
  type               ReferralType
  priority           ReferralPriority @default(P3)
  status             ReferralStatus   @default(PENDING)
  reason             String?
  clinicalNotes      String?

  // Phase 1: Timeliness tracking
  timelinessDays     Int?
  targetDays         Int? // P1=20, P2=42, P3=84, P4=168
  escalationSentAt   DateTime?
  appointmentDate    DateTime?
  letterSentAt       DateTime?
  responseReceivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priority, status, createdAt])
}

// ─── Recall ──────────────────────────────────────────────────────────────────

model Recall {
  id          String       @id @default(cuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  practiceId  String?
  practice    GPPractice?  @relation(fields: [practiceId], references: [id])
  status      RecallStatus @default(PENDING)
  dueDate     DateTime
  sentAt      DateTime?
  respondedAt DateTime?
  reason      String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([dueDate, status])
}

// ─── Versioned National Clinical Rule Graph ──────────────────────────────────

model ClinicalRuleSet {
  id              String                  @id @default(cuid())
  key             String                  @unique
  name            String
  description     String?
  scope           ClinicalRuleScope       @default(GLOBAL)
  // The application does not yet have a general tenant model. This stable key
  // is intentionally nullable until a governed organisation boundary exists.
  organisationKey String?
  versions        ClinicalRuleVersion[]
  activations     RuleSetActivation[]
  evaluations     RuleEvaluation[]
  auditEvents     RuleVersionAuditEvent[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([scope, organisationKey])
}

model ClinicalRuleVersion {
  id                     String                           @id @default(cuid())
  ruleSetId              String
  ruleSet                ClinicalRuleSet                  @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  versionMajor           Int
  versionMinor           Int
  versionPatch           Int
  displayVersion         String
  status                 ClinicalRuleVersionStatus        @default(DRAFT)
  parentVersionId        String?
  parentVersion          ClinicalRuleVersion?             @relation("ClinicalRuleVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  childVersions          ClinicalRuleVersion[]            @relation("ClinicalRuleVersionParent")
  sourcePackageVersion   String?
  sourceGuidelineSummary String
  snapshotJson           String
  checksum               String?
  revision               Int                              @default(1)
  changeSummary          String?
  changeClassification   ClinicalRuleChangeClassification @default(CLINICAL_LOGIC)
  validationJson         String?
  createdById            String?
  createdBy              User?                            @relation("ClinicalRuleVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById           String?
  approvedBy             User?                            @relation("ClinicalRuleVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedById          String?
  publishedBy            User?                            @relation("ClinicalRuleVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  validatedAt            DateTime?
  publishedAt            DateTime?
  activatedAt            DateTime?
  retiredAt              DateTime?
  activations            RuleSetActivation[]
  evaluations            RuleEvaluation[]
  auditEvents            RuleVersionAuditEvent[]
  pinnedBatchRuns        BatchRun[]                       @relation("PinnedClinicalRuleVersion")
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@unique([ruleSetId, displayVersion])
  @@index([ruleSetId, status, createdAt])
  @@index([parentVersionId])
  @@index([checksum])
}

model RuleSetActivation {
  id              String                    @id @default(cuid())
  ruleSetId       String
  ruleSet         ClinicalRuleSet           @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  ruleVersionId   String
  ruleVersion     ClinicalRuleVersion       @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  organisationKey String?
  environment     RuleActivationEnvironment @default(DEMO)
  isDefault       Boolean                   @default(true)
  activatedById   String?
  activatedBy     User?                     @relation("ClinicalRuleActivationActor", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedAt     DateTime                  @default(now())
  deactivatedAt   DateTime?
  reason          String

  @@index([ruleSetId, organisationKey, environment, deactivatedAt])
  @@index([ruleVersionId, activatedAt])
}

model RuleEvaluation {
  id                            String              @id @default(cuid())
  caseId                        String?
  referralCase                  ReferralCase?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  batchRunId                    String?
  batchRun                      BatchRun?           @relation(fields: [batchRunId], references: [id], onDelete: SetNull)
  batchReviewItem               BatchReviewItem?
  wizardSession                 WizardSession?
  ruleSetId                     String
  ruleSet                       ClinicalRuleSet     @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  ruleVersionId                 String
  ruleVersion                   ClinicalRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  ruleVersionDisplay            String
  rulesetChecksum               String
  engineVersion                 String
  evaluationMode                RuleEvaluationMode  @default(LIVE_DEMO)
  evaluatedAt                   DateTime            @default(now())
  canonicalInputSnapshot        String
  matchedRuleIds                String
  branchPath                    String
  provisionalRecommendation     String
  riskLevel                     String
  urgency                       String?
  referralDestination           String?
  repeatInterval                String?
  missingInformation            String
  reviewerRequirement           String
  mandatoryReviewerConfirmation Boolean             @default(true)
  clinicianOnly                 Boolean             @default(false)
  sourceReferences              String
  evaluationTrace               String
  previousEvaluationId          String?
  previousEvaluation            RuleEvaluation?     @relation("RuleEvaluationRegrade", fields: [previousEvaluationId], references: [id], onDelete: Restrict)
  subsequentEvaluations         RuleEvaluation[]    @relation("RuleEvaluationRegrade")
  regradeReason                 String?
  createdAt                     DateTime            @default(now())

  @@index([caseId, evaluatedAt])
  @@index([batchRunId, evaluatedAt])
  @@index([ruleVersionId, evaluatedAt])
  @@index([previousEvaluationId])
}

model RuleVersionAuditEvent {
  id            String               @id @default(cuid())
  ruleSetId     String
  ruleSet       ClinicalRuleSet      @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  ruleVersionId String?
  ruleVersion   ClinicalRuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  actorUserId   String?
  actorUser     User?                @relation("ClinicalRuleAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType     String
  reason        String?
  beforeJson    String?
  afterJson     String?
  ipAddress     String?
  userAgent     String?
  /// True when this governance event was recorded while DEMO_MODE was enabled.
  /// Durable provenance: a demonstration attestation stays identifiable after
  /// DEMO_MODE is turned off, and is refused by the real activation gates.
  isDemo        Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@index([ruleSetId, createdAt])
  @@index([ruleVersionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([isDemo, eventType])
}

// ─── Wizard Session ───────────────────────────────────────────────────────────

model WizardSession {
  id                 String          @id @default(cuid())
  patientId          String
  patient            Patient         @relation(fields: [patientId], references: [id])
  createdById        String
  createdBy          User            @relation(fields: [createdById], references: [id])
  status             WizardStatus    @default(IN_PROGRESS)
  determinedFigure   PathwayFigure?
  decisionJson       String? // JSON blob of final ClinicalDecision
  ruleEvaluationId   String?         @unique
  ruleEvaluation     RuleEvaluation? @relation(fields: [ruleEvaluationId], references: [id], onDelete: SetNull)
  screeningSessionId String?         @unique
  answers            WizardAnswer[]
  startedAt          DateTime        @default(now())
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([patientId, status])
  @@index([createdById])
}

model WizardAnswer {
  id              String        @id @default(cuid())
  wizardSessionId String
  wizardSession   WizardSession @relation(fields: [wizardSessionId], references: [id], onDelete: Cascade)
  stepId          String
  questionText    String
  answerValue     String
  answerLabel     String
  isAutoFilled    Boolean       @default(false)
  stepNumber      Int
  createdAt       DateTime      @default(now())

  @@unique([wizardSessionId, stepId])
  @@index([wizardSessionId])
}

// ─── Case Investigation ──────────────────────────────────────────────────────

model CaseInvestigation {
  id                String       @id @default(cuid())
  caseId            String
  referralCase      ReferralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              String // e.g. Colposcopy, Biopsy, Imaging, Blood test
  result            String?
  notes             String?
  investigationDate DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([caseId, createdAt])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  action        String
  entity        String
  entityId      String?
  oldValue      String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  exportEvent   Boolean       @default(false)
  severity      AuditSeverity @default(INFO)
  correlationId String? // links related audit events in a single request/operation
  sessionId     String? // NextAuth session token (hashed) for session-level tracing
  createdAt     DateTime      @default(now())

  @@index([entity, action])
  @@index([userId, createdAt])
  @@index([entityId])
  @@index([severity, createdAt])
  @@index([correlationId])
}

// ─── Patient Consent Records ─────────────────────────────────────────────────
// NZ Privacy Act 2020 — explicit consent tracking per purpose.

model PatientConsent {
  id            String         @id @default(cuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  status        ConsentStatus  @default(GIVEN)
  givenAt       DateTime       @default(now())
  givenByUserId String? // clinician or coordinator who recorded consent
  withdrawnAt   DateTime?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([patientId, purpose, status])
  @@index([status, expiresAt])
}

// ─── AI Recommendation ────────────────────────────────────────────────────────

model AIRecommendation {
  id                      String          @id @default(cuid())
  caseId                  String
  referralCase            ReferralCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  modelName               String // e.g. "claude-sonnet-4-6"
  modelVersion            String
  promptVersion           String // semver of the prompt template used
  inputJson               String // serialised input sent to the model
  outputJson              String // raw model response
  suggestedPriority       TriagePriority?
  suggestedCategory       String?
  suggestedOutcome        String?
  rationale               String?
  confidence              Float? // 0–1 model confidence where available
  citations               String? // JSON array of source document citations
  concordantWithRule      Boolean? // true if matches deterministic rule recommendation
  concordantWithClinician Boolean? // true if clinician confirmed without override
  generatedByUserId       String?
  createdAt               DateTime        @default(now())

  @@index([caseId, createdAt])
  @@index([suggestedPriority, createdAt])
  @@index([concordantWithRule, concordantWithClinician])
}

// ─── Batch Run + Review Worklist ──────────────────────────────────────────────
// Bridges the batch decision engine to the reviewer queue. A BatchRun persists a
// set of pre-graded cases (from any source — file upload today, HL7v2/ERMS feed
// later) so a reviewer can bulk accept/reject with the full picture, instead of
// the in-memory throwaway results the batch screen produced before.

model BatchRun {
  id                       String               @id @default(cuid())
  /// The tenant this run belongs to.
  ///
  /// Optional at the database level only because the column was added to an
  /// existing table: SQLite cannot add a NOT NULL column that also carries a
  /// REFERENCES clause, and rebuilding BatchRun would mean rebuilding a table
  /// that immutable RuleEvaluation rows point at. Existing rows are backfilled
  /// to the default organisation by the migration, every write path supplies it
  /// through requireCurrentOrganisationId(), and a test asserts no run is ever
  /// created without one — so it is required in practice.
  organisationId           String?
  organisation             Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  source                   BatchRunSource
  sourceSystem             String?
  sourceFileName           String?
  engineVersion            String
  pinnedRuleVersionId      String?
  pinnedRuleVersion        ClinicalRuleVersion? @relation("PinnedClinicalRuleVersion", fields: [pinnedRuleVersionId], references: [id], onDelete: Restrict)
  pinnedRuleVersionDisplay String?
  pinnedRulesetChecksum    String?
  totalCases               Int
  pendingCount             Int                  @default(0)
  acceptedCount            Int                  @default(0)
  rejectedCount            Int                  @default(0)
  needsInfoCount           Int                  @default(0)
  // Number of items the engine flagged for mandatory clinician review
  // (safety stop, insufficient info, external dependency, or processing error).
  reviewRequiredCount      Int                  @default(0)
  createdByUserId          String
  createdBy                User                 @relation("BatchRunCreator", fields: [createdByUserId], references: [id])
  items                    BatchReviewItem[]
  ruleEvaluations          RuleEvaluation[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([source, createdAt])
  @@index([organisationId, createdAt])
}

model BatchReviewItem {
  id                String    @id @default(cuid())
  batchRunId        String
  batchRun          BatchRun  @relation(fields: [batchRunId], references: [id], onDelete: Cascade)
  rowNumber         Int
  label             String?
  externalPatientId String?
  patientAge        Int?
  ethnicityPrimary  String?
  // Display identity (demo data is synthetic; in production these come from the
  // source system's PID/patient resource). Held for the reviewer worklist only.
  patientName       String?
  nhi               String?
  gpPractice        String?
  receivedDate      DateTime?

  // ── Episode identity ──────────────────────────────────────────────────────
  //
  // Kept in clear, not only as a fingerprint. A reviewer asked to accept that
  // two results are the same episode must be able to see "accession A12345 from
  // Awanui Labs", and a usage dispute is answered the same way.
  //
  /// Accession / specimen identifier. NOT a message control ID — that names one
  /// transmission and changes on resend; this names the specimen and does not.
  sourceEpisodeKey  String?
  /// Originating laboratory or facility. Not the tenant.
  sourceFacility    String?
  testType          String?
  collectedOn       DateTime?

  /// Digest of everything that arrived. Changes when a name spelling or
  /// demographic detail is corrected — useful provenance, but it must never
  /// drive re-evaluation, because no governed rule reads those fields.
  rawPayloadDigest      String?
  /// Digest of the normalised clinical facts only. This is the ONLY digest that
  /// may cause a case to be treated as an updated result.
  clinicalPayloadDigest String?

  // Engine output snapshot (denormalised for fast worklist sorting/filtering)
  figure             String
  riskLevel          String
  recommendationCode String
  recommendation     String
  referralPriority   String?
  referralType       String?
  safetyOutcome      String?
  // True when the engine refused to silently auto-decide and a clinician must
  // look (safety stop / insufficient info / external dependency / error).
  reviewRequired     Boolean @default(false)
  engineStatus       String  @default("success") // success | error

  // Full payloads so the reviewer drill-in can reconstruct the BatchCaseResult
  // without re-running the engine. caseJson = CanonicalBatchCase, inputJson =
  // ClinicalInput, decisionJson = ClinicalDecision.
  ruleEvaluationId   String?         @unique
  ruleEvaluation     RuleEvaluation? @relation(fields: [ruleEvaluationId], references: [id], onDelete: SetNull)
  caseJson           String
  inputJson          String
  decisionJson       String
  // Stored authority provenance lets Case Review render canonical-first only
  // when the evaluation that produced this decision was genuinely operative.
  authorityEngine    String          @default("LEGACY")
  authorityReason    String?
  legacyDecisionJson String?

  // Reviewer disposition
  disposition      BatchReviewDisposition @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?                  @relation("BatchItemReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  overrideReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchRunId, disposition])
  @@index([batchRunId, reviewRequired])
  @@index([reviewedByUserId, reviewedAt])
  @@index([sourceEpisodeKey])
}

/// One delivery, recorded so it is never processed twice.
///
/// TRANSPORT IDENTITY ONLY — NOTHING CLINICAL
/// ------------------------------------------
/// `deliveryKey` is whatever names a single transmission on that channel: an
/// HL7 MSH-10 message control ID, an uploaded file's content hash, a connector's
/// delivery id. It answers "have we already received this?" and nothing else.
///
/// It is deliberately NOT clinical episode identity, and the two must never be
/// merged. A lab resends the same episode under a new control number, and an
/// amended report always does — so a control number cannot recognise an
/// amendment. Conversely the same message redelivered by a flaky transport is
/// one episode, not two. Using either key for the other's job produces both
/// false duplicates and missed updates.
model IngestionReceipt {
  id             String   @id @default(cuid())
  organisationId String
  /// upload | demo-connector | manual | fhir | hl7-gateway
  channel        String
  deliveryKey    String
  batchRunId     String?
  receivedAt     DateTime @default(now())
  caseCount      Int      @default(0)

  /// Scoped by organisation and channel: two channels may legitimately use the
  /// same identifier space, and two tenants certainly do.
  @@unique([organisationId, channel, deliveryKey])
  @@index([organisationId, receivedAt])
}
